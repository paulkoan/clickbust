<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site.site_title }}</title>
<meta name="description" content="{{ site.site_description }}">
<meta name="robots" content="index, follow">
<meta name="google-site-verification" content="HrPazGiSD1g-kaGJxhzL6YpOUAYGMlK4_nvy_uz4QAo" />
<link rel="icon" type="image/png" href="https://www.google.com/s2/favicons?domain=cybr.fi&sz=32">

<!-- Google Discover / News meta -->
<meta property="og:title" content="{{ site.site_title }}">
<meta property="og:description" content="{{ site.site_description }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.base_url }}">
<meta name="twitter:card" content="summary">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f0f0f;
    color: #e0e0e0;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }
  header {
    text-align: center;
    padding: 40px 0 30px;
    border-bottom: 1px solid #1e1e2e;
    margin-bottom: 30px;
  }
  header h1 { font-size: 1.8rem; color: #fff; margin-bottom: 8px; }
  header p { color: #888; font-size: 0.9rem; }
  .nav-links { margin-top: 12px; }
  .nav-links a {
    color: #7c5cfc;
    text-decoration: none;
    font-size: 0.85rem;
    margin: 0 8px;
  }
  .nav-links a:hover { text-decoration: underline; }
  .article-card {
    background: #1a1a2e;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    border: 1px solid #2a2a4a;
    transition: border-color 0.2s;
  }
  .article-card:hover { border-color: #7c5cfc; }
  .article-card h2 { font-size: 1.15rem; margin-bottom: 8px; line-height: 1.4; }
  .article-card h2 a {
    color: #e0e0e0;
    text-decoration: none;
  }
  .article-card h2 a:hover { color: #7c5cfc; }
  .article-card p.meta {
    color: #666;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }
  .article-card p.meta .site-tag {
    display: inline-block;
    background: #2a2a4a;
    padding: 2px 8px;
    border-radius: 10px;
    color: #aaa;
    font-size: 0.75rem;
  }
  .article-card .summary {
    color: #999;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .article-card .clickbait-badge {
    display: inline-block;
    background: #3a1a1a;
    color: #ff6b6b;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    margin-left: 6px;
  }
  .original-title {
    color: #666;
    font-size: 0.8rem;
    text-decoration: line-through;
    margin-top: 6px;
  }
  footer {
    text-align: center;
    padding: 30px 0;
    color: #555;
    font-size: 0.8rem;
  }
  footer a { color: #7c5cfc; text-decoration: none; }
  .stats {
    text-align: center;
    color: #666;
    font-size: 0.85rem;
    margin-bottom: 20px;
  }
  .site-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
    margin-bottom: 30px;
  }
  .site-card {
    background: #1a1a2e;
    border-radius: 12px;
    padding: 24px;
    border: 1px solid #2a2a4a;
    text-align: center;
    transition: border-color 0.2s;
    text-decoration: none;
    display: block;
    color: inherit;
  }
  .site-card:hover { border-color: #7c5cfc; }
  .site-card img {
    width: 48px;
    height: 48px;
    border-radius: 8px;
    margin-bottom: 12px;
  }
  .site-card h2 { font-size: 1.2rem; color: #fff; margin-bottom: 4px; }
  .site-card p { color: #888; font-size: 0.85rem; }
  .recent-section h3 {
    font-size: 1rem;
    color: #888;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 1px;
  }
</style>
</head>
<body>
<header>
  <h1>{{ site.site_title }}</h1>
  <p>{{ site.site_description }}</p>
  <div class="nav-links">
    <a href="{{ site.base_url }}/notes/">Notes</a>
    <a href="{{ site.base_url }}/about.html">About</a>
  </div>
</header>

<div class="stats">
  {{ articles|length }} articles · {{ sites|length }} sites · Generated {{ generated_at }}
</div>

<div class="site-grid">
{% for site_info in sites %}
  <a href="/{{ site_info.slug }}.html" class="site-card">
    <img src="https://www.google.com/s2/favicons?domain={{ site_info.domain }}&sz=64" alt="" width="48" height="48">
    <h2>{{ site_info.name }}</h2>
    <p>{{ site_info.count }} articles</p>
  </a>
{% endfor %}
</div>

<div class="recent-section">
<h3>Recent Articles</h3>

<main>
{% for article in articles %}
<article class="article-card">
  <p class="meta">
    <span class="site-tag">{{ article.site_name }}</span>
    {% if article.published_date %}
    · {{ article.published_date.strftime('%d %b %Y') }}
    {% endif %}
  </p>
  <h2>
    <a href="{{ article.url }}">
      {% if article.is_clickbait and article.rewritten_title %}
        {{ article.rewritten_title }}
        <span class="clickbait-badge">REWRITTEN</span>
      {% else %}
        {{ article.title }}
      {% endif %}
    </a>
  </h2>
  {% if article.is_clickbait and article.rewritten_title %}
  <div class="original-title">Original: {{ article.title }}</div>
  {% endif %}
  {% if article.summary %}
  <div class="summary">{{ article.summary[:250] }}{% if article.summary|length > 250 %}…{% endif %}</div>
  {% endif %}
</article>
{% endfor %}
</main>

</div>

<footer>
  <p>Powered by <a href="https://github.com/paulkoan/clickbust">Clickbust</a> · All articles link to original sources</p>
</footer>
</body>
</html>