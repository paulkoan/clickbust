<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Notes — {{ site_name }}</title>
<meta name="description" content="Daily notes by Paul Murphy — tech, deals, and things that catch my eye">
<meta name="robots" content="index, follow">
<meta name="google-site-verification" content="HrPazGiSD1g-kaGJxhzL6YpOUAYGMlK4_nvy_uz4QAo" />
<link rel="icon" type="image/png" href="https://www.google.com/s2/favicons?domain=cybr.fi&sz=32">

<meta property="og:title" content="Notes — {{ site_name }}">
<meta property="og:description" content="Daily notes by Paul Murphy">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ base_url }}/notes/">
<meta name="twitter:card" content="summary">
<link rel="alternate" type="application/rss+xml" title="{{ site_name }}" href="{{ base_url }}/feed.xml">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f0f0f;
    color: #e0e0e0;
    max-width: 700px;
    margin: 0 auto;
    padding: 20px;
  }
  header {
    text-align: center;
    padding: 40px 0 30px;
    border-bottom: 1px solid #1e1e2e;
    margin-bottom: 30px;
  }
  header h1 { font-size: 1.5rem; color: #fff; margin-bottom: 8px; }
  header p { color: #888; font-size: 0.9rem; }
  .back-link {
    display: inline-block;
    color: #7c5cfc;
    text-decoration: none;
    font-size: 0.85rem;
  }
  .back-link:hover { text-decoration: underline; }
  .note-card {
    background: #1a1a2e;
    border-radius: 12px;
    padding: 20px 24px;
    margin-bottom: 12px;
    border: 1px solid #2a2a4a;
    transition: border-color 0.2s;
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .note-card:hover { border-color: #7c5cfc; }
  .note-card .date {
    color: #666;
    font-size: 0.8rem;
    margin-bottom: 6px;
  }
  .note-card h2 {
    font-size: 1.1rem;
    color: #fff;
    margin-bottom: 6px;
    line-height: 1.4;
  }
  .note-card .preview {
    color: #999;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  footer {
    text-align: center;
    padding: 30px 0;
    color: #555;
    font-size: 0.8rem;
  }
  footer a { color: #7c5cfc; text-decoration: none; }
</style>
</head>
<body>
<header>
  <a href="{{ base_url }}" class="back-link">← Clickbust</a>
  <h1>Notes</h1>
  <p>Daily notes by Paul Murphy — tech, deals, and things that catch my eye</p>
</header>

<main>
{% for note in notes %}
<a href="{{ note.url }}" class="note-card">
  <div class="date">{{ note.date }}</div>
  <h2>{{ note.title }}</h2>
  <div class="preview">{{ note.preview }}</div>
</a>
{% endfor %}
</main>

<footer>
  <p><a href="{{ base_url }}">Clickbust</a> · <a href="{{ base_url }}/about.html">About</a></p>
</footer>
</body>
</html>