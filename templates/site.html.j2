<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ site_name }} — {{ site.site_title }}</title>
<meta name="description" content="Clickbait-free headlines from {{ site_name }}">
<meta name="robots" content="index, follow">
<meta name="google-site-verification" content="HrPazGiSD1g-kaGJxhzL6YpOUAYGMlK4_nvy_uz4QAo" />
<link rel="icon" type="image/png" href="https://www.google.com/s2/favicons?domain={{ site_domain }}&sz=32">

<!-- Google Discover / News meta -->
<meta property="og:title" content="{{ site_name }} — {{ site.site_title }}">
<meta property="og:description" content="Clickbait-free headlines from {{ site_name }}">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.base_url }}/{{ site_slug }}.html">
<meta property="og:image" content="{{ site.base_url }}/assets/og-default.svg">
<meta name="twitter:card" content="summary">
<link rel="alternate" type="application/rss+xml" title="{{ site_name }}" href="{{ site.base_url }}/feed.xml">

<!-- JSON-LD schema -->
<script type="application/ld+json">
{
  {"@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ (site_name + " — " + site.site_title) | tojson }},
    "description": {{ ("Clickbait-free headlines from " + site_name) | tojson }},
    "url": {{ (site.base_url + "/" + site_slug + ".html") | tojson }},
    "mainEntity": {"@type": "ItemList", "itemListElement": []},
    "publisher": {"@type": "Organization", "name": "Paul Murphy", "url": {{ site.base_url | tojson }}}
  }
</script>

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f0f0f;
    color: #e0e0e0;
    max-width: 800px;
    margin: 0 auto;
    padding: 20px;
  }
  header {
    text-align: center;
    padding: 40px 0 30px;
    border-bottom: 1px solid #1e1e2e;
    margin-bottom: 30px;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin-bottom: 8px;
  }
  .site-header img {
    width: 32px;
    height: 32px;
    border-radius: 6px;
  }
  .site-header h1 { font-size: 1.8rem; color: #fff; }
  .back-link {
    display: inline-block;
    color: #7c5cfc;
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 12px;
  }
  .back-link:hover { text-decoration: underline; }
  header p { color: #888; font-size: 0.9rem; }
  .article-card {
    display: block;
    background: #1a1a2e;
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 16px;
    border: 1px solid #2a2a4a;
    transition: border-color 0.2s;
    text-decoration: none;
    color: inherit;
  }
  .article-card:hover { border-color: #7c5cfc; }
  .article-card .card-inner {
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .article-card .card-thumb {
    flex-shrink: 0;
    width: 160px;
    height: 100px;
    border-radius: 8px;
    overflow: hidden;
    background: #2a2a4a;
  }
  @media (max-width: 600px) {
    .article-card .card-inner { flex-direction: column; }
    .article-card .card-thumb { width: 100%; height: auto; aspect-ratio: 16/9; }
  }
  .article-card .card-thumb img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .article-card .card-body { flex: 1; min-width: 0; }
  .article-card h2 { font-size: 1.15rem; margin-bottom: 8px; line-height: 1.4; }
  .article-card h2 .clickable-title { color: #e0e0e0; }
  .article-card p.meta {
    color: #666;
    font-size: 0.8rem;
    margin-bottom: 8px;
  }
  .article-card .summary {
    color: #999;
    font-size: 0.85rem;
    line-height: 1.5;
  }
  .article-card .clickbait-badge {
    display: inline-block;
    background: #3a1a1a;
    color: #ff6b6b;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    margin-left: 6px;
  }
  .original-title {
    color: #666;
    font-size: 0.8rem;
    text-decoration: line-through;
    margin-top: 6px;
  }
  footer {
    text-align: center;
    padding: 30px 0;
    color: #555;
    font-size: 0.8rem;
  }
  footer a { color: #7c5cfc; text-decoration: none; }
  .stats {
    text-align: center;
    color: #666;
    font-size: 0.85rem;
    margin-bottom: 20px;
  }
  .preferred-source {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: transparent;
    color: #7c5cfc;
    border: 1px solid #3a3a5c;
    padding: 10px 22px;
    border-radius: 24px;
    font-size: 0.85rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s;
  }
  .preferred-source:hover {
    border-color: #7c5cfc;
    background: rgba(124, 92, 252, 0.08);
  }
  .preferred-source .icon { font-size: 1rem; }
  .preferred-source .hint {
    display: block;
    color: #666;
    font-size: 0.7rem;
    font-weight: 400;
    margin-top: 1px;
  }
  .site-stats {
    display: flex;
    gap: 16px;
    justify-content: center;
    margin-bottom: 30px;
    flex-wrap: wrap;
  }
  .stat-card {
    background: #1a1a2e;
    border: 1px solid #2a2a4a;
    border-radius: 12px;
    padding: 16px 24px;
    text-align: center;
    min-width: 140px;
    flex: 1;
    max-width: 200px;
  }
  .stat-value {
    display: block;
    font-size: 1.8rem;
    font-weight: 700;
    color: #7c5cfc;
    line-height: 1.2;
  }
  .stat-label {
    display: block;
    font-size: 0.75rem;
    color: #888;
    margin-top: 4px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }
</style>
</head>
<body>
<header>
  <a href="{{ site.base_url }}" class="back-link">← All sites</a>
  <div class="site-header">
    <img src="https://www.google.com/s2/favicons?domain={{ site_domain }}&sz=64" alt="" width="32" height="32">
    <h1>{{ site_name }}</h1>
  </div>
  <p>{{ site_description }}</p>
  <div style="margin-top: 16px;">
    <a href="https://google.com/preferences/source?q=clickbust.cybr.fi" class="preferred-source" target="_blank" rel="noopener">
      <span class="icon">+</span>
      <span>
        Add Clickbust as preferred source
        <span class="hint">Follow clickbust.cybr.fi in Google Discover to get clickbait-free headlines</span>
      </span>
    </a>
  </div>
</header>

<div class="stats">
  {{ articles|length }} articles · Generated {{ generated_at }}
</div>

{% if site_stats.total_runs > 0 %}
<div class="site-stats">
  <div class="stat-card">
    <span class="stat-value">{{ site_stats.total_clickbait }}</span>
    <span class="stat-label">Headlines rewritten (all-time)</span>
  </div>
  <div class="stat-card">
    <span class="stat-value">{{ site_stats.average_daily }}</span>
    <span class="stat-label">Daily average</span>
  </div>
  <div class="stat-card">
    <span class="stat-value">{{ site_stats.total_runs }}</span>
    <span class="stat-label">Runs tracked</span>
  </div>
</div>
{% endif %}

<main>
{% for article in articles %}
<a href="{{ article.url }}" class="article-card">
  <div class="card-inner">
    {% if article.image_url %}
    <div class="card-thumb">
      <img src="{{ article.image_url }}" alt="" loading="lazy">
    </div>
    {% endif %}
    <div class="card-body">
      <p class="meta">
        {% if article.published_date %}
        {{ article.published_date.strftime('%d %b %Y') }}
        {% endif %}
      </p>
      <h2>
        <span class="clickable-title">
          {% if article.is_clickbait and article.rewritten_title %}
            {{ article.rewritten_title }}
            <span class="clickbait-badge">REWRITTEN</span>
          {% else %}
            {{ article.title }}
          {% endif %}
        </span>
      </h2>
      {% if article.is_clickbait and article.rewritten_title %}
      <div class="original-title">Original: {{ article.title }}</div>
      {% endif %}
      {% if article.summary %}
      <div class="summary">{{ article.summary[:250] }}{% if article.summary|length > 250 %}&hellip;{% endif %}</div>
      {% endif %}
    </div>
  </div>
</a>
{% endfor %}
</main>

<footer>
  <p>Powered by <a href="https://github.com/paulkoan/clickbust">Clickbust</a> · All articles link to original sources</p>
</footer>
</body>
</html>