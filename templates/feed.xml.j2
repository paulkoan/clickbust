<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0"
     xmlns:atom="http://www.w3.org/2005/Atom"
     xmlns:media="http://search.yahoo.com/mrss/"
     xmlns:dc="http://purl.org/dc/elements/1.1/">
<channel>
  <title>{{ site.site_title }}</title>
  <link>{{ site.base_url }}</link>
  <description>{{ site.site_description }}</description>
  <language>en</language>
  <lastBuildDate>{{ generated_at }}</lastBuildDate>
  <atom:link href="{{ site.base_url }}/feed.xml" rel="self" type="application/rss+xml"/>

{% for article in articles %}
{% set display_title = article.rewritten_title if article.is_clickbait and article.rewritten_title else article.title %}
  <item>
    <title><![CDATA[{{ display_title }}]]></title>
    <link>{{ site.base_url }}/a/{{ article.article_id }}.html</link>
    <guid isPermaLink="true">{{ site.base_url }}/a/{{ article.article_id }}.html</guid>
    <description><![CDATA[
      {% if article.image_url %}<img src="{{ article.image_url }}" alt="" style="max-width:100%;height:auto;margin-bottom:12px">{% endif %}
      <p><strong>{{ display_title }}</strong></p>
      {% if article.summary %}<p>{{ article.summary }}</p>{% endif %}
      <p><small>Originally published at {{ article.site_name }}</small></p>
    ]]></description>
    {% if article.image_url %}<media:content url="{{ article.image_url }}" medium="image" />{% endif %}
    <dc:source>{{ article.site_name }}</dc:source>
    {% if article.published_date %}
    <pubDate>{{ article.published_date.strftime('%a, %d %b %Y %H:%M:%S +0000') }}</pubDate>
    {% endif %}
  </item>
{% endfor %}

{% for note in notes %}
  <item>
    <title><![CDATA[{{ note.title }}]]></title>
    <link>{{ site.base_url }}/notes/{{ note.filename }}</link>
    <guid isPermaLink="true">{{ site.base_url }}/notes/{{ note.filename }}</guid>
    <description><![CDATA[
      <p><strong>{{ note.title }}</strong></p>
      <p>{{ note.preview }}</p>
      <p><small>Note</small></p>
    ]]></description>
    <dc:source>Clickbust</dc:source>
    <pubDate>{{ note.pub_date }}</pubDate>
  </item>
{% endfor %}
</channel>
</rss>