<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }}</title>
<meta name="description" content="{{ meta_description }}">
<meta name="robots" content="index, follow">
<meta name="google-site-verification" content="HrPazGiSD1g-kaGJxhzL6YpOUAYGMlK4_nvy_uz4QAo" />
<link rel="icon" type="image/png" href="https://www.google.com/s2/favicons?domain=cybr.fi&sz=32">

<!-- Google Discover / News meta -->
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ meta_description }}">
<meta property="og:url" content="{{ base_url }}/notes/{{ filename }}">
<meta property="og:type" content="article">
<meta property="og:site_name" content="{{ site_name }}">
<meta property="article:published_time" content="{{ published_date }}">
<meta property="article:author" content="Paul">
<meta name="twitter:card" content="summary">
<meta name="twitter:title" content="{{ title }}">
<meta name="twitter:description" content="{{ meta_description }}">
<link rel="alternate" type="application/rss+xml" title="{{ site_name }}" href="{{ base_url }}/feed.xml">

<style>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0f0f0f;
    color: #e0e0e0;
    line-height: 1.6;
  }
  .container {
    max-width: 700px;
    margin: 0 auto;
    padding: 20px;
  }
  header {
    padding: 40px 0 20px;
    border-bottom: 1px solid #1e1e2e;
    margin-bottom: 30px;
  }
  .back-link {
    display: inline-block;
    color: #7c5cfc;
    text-decoration: none;
    font-size: 0.85rem;
    margin-bottom: 20px;
  }
  .back-link:hover { text-decoration: underline; }
  h1 { font-size: 1.6rem; color: #fff; line-height: 1.35; margin-bottom: 12px; }
  .date {
    color: #666;
    font-size: 0.85rem;
    margin-bottom: 24px;
  }
  .body {
    font-size: 1.05rem;
    color: #ccc;
    line-height: 1.8;
  }
  .body p {
    margin-bottom: 1.2em;
  }
  .body p:last-child { margin-bottom: 0; }
  hr {
    border: none;
    border-top: 1px solid #2a2a2a;
    margin: 30px 0;
  }
  .notes-link {
    display: inline-block;
    background: #1a1a2e;
    color: #7c5cfc;
    padding: 8px 16px;
    border-radius: 8px;
    text-decoration: none;
    font-size: 0.85rem;
    border: 1px solid #2a2a4a;
    margin-bottom: 20px;
  }
  .notes-link:hover { border-color: #7c5cfc; }
  footer {
    text-align: center;
    padding: 30px 0;
    color: #555;
    font-size: 0.8rem;
    border-top: 1px solid #1e1e2e;
    margin-top: 40px;
  }
  footer a { color: #7c5cfc; text-decoration: none; }
</style>
</head>
<body>
<div class="container">
  <div>
    <a href="{{ base_url }}/notes/" class="notes-link">← All Notes</a>
    <a href="{{ base_url }}" class="back-link" style="margin-left: 12px;">Clickbust</a>
  </div>

  <header>
    <h1>{{ title }}</h1>
    <div class="date">{{ published_date }}</div>
  </header>

  <div class="body">
    {{ body_html }}
  </div>
</div>

<footer>
  <div class="container">
    <p>Paul · <a href="{{ base_url }}/notes/">All notes</a> · <a href="{{ base_url }}">Clickbust</a></p>
  </div>
</footer>
</body>
</html>